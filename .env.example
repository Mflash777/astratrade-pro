# ---------- Core ----------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
# SQLite for local dev; use postgresql+psycopg://user:pass@host:5432/astratrade in production
DATABASE_URL=sqlite:///./astratrade.db
CORS_ORIGINS=http://localhost:3000,https://YOUR_GITHUB_USERNAME.github.io

# ---------- LLM (optional; "mock" uses the built-in rule engine) ----------
LLM_PROVIDER=mock            # mock | openai | anthropic
LLM_MODEL=gpt-4o-mini        # or claude-sonnet-4-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Alpaca brokerage (paper by default) ----------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Set ALPACA_LIVE_TRADING_ENABLED=true ONLY when you intend to send real-money orders.
ALPACA_LIVE_TRADING_ENABLED=false

# ---------- Data sources (all optional; mock/synthetic data is used when blank) ----------
# Market data: Yahoo Finance via `yfinance` is used automatically, no key needed.
# Set to "alpaca" to force Alpaca market data instead, or "synthetic" to force mock data.
MARKET_DATA_SOURCE=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
NEWS_API_KEY=
SEC_USER_AGENT=AstraTradePro contact@example.com
# Congressional trading: Senate/House Stock Watcher are used automatically, no key needed.
# Set QUIVER_API_KEY to use Quiver Quantitative's feed instead (more current, paid tiers available).
QUIVER_API_KEY=

# ---------- Default admin bootstrap ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
