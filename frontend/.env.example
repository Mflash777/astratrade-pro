# Backend URL. Leave empty on GitHub Pages to run the terminal in demo mode with
# built-in mock data; set to your deployed API (e.g. https://api.yourdomain.com) to go live.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to "/<repo-name>" when hosting at https://<user>.github.io/<repo-name>/
NEXT_PUBLIC_BASE_PATH=
